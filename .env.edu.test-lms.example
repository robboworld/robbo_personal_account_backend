# TEMP: prod LK → staging LMS IdP (IdP + MySQL must point to the same LMS).
# Copy into backend/.env on the LK host; rollback via your saved .env backup.
# Runbook: architecture/runbooks/lk-edu-test-lms-idp-switch.md

AUTH_MODE=oidc_bff
AUTH_LMS_PASSWORD_FALLBACK=false
LK_SSO_WITH_LMS_ENABLED=true
LEGACY_POSTGRES_ENABLED=false
PORTAL_OUTBOX_ENABLED=false

PROJECTS_POSTGRES_DSN=host=host.docker.internal port=5433 user=robbo_projects password=CHANGE_ME dbname=robbo_projects sslmode=disable
LICENSING_POSTGRES_DSN=host=host.docker.internal port=5434 user=robbo_licensing password=CHANGE_ME dbname=robbo_licensing sslmode=disable

# Staging LMS MySQL — allowlist LK egress → LMS host:3306 (see runbook)
LMS_MYSQL_DSN=lk_readonly:CHANGE_ME@tcp(203.0.113.11:3306)/openedx
LMS_MYSQL_WRITE_DSN=lk_write:CHANGE_ME@tcp(203.0.113.11:3306)/openedx

OIDC_ISSUER=https://lms-staging.example.com/oauth2
OIDC_AUTHORIZATION_ENDPOINT=https://lms-staging.example.com/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://lms-staging.example.com/oauth2/access_token
OIDC_JWKS_URI=https://lms-staging.example.com/auth/jwks.json
OIDC_CLIENT_ID=lk-web
OIDC_AUDIENCE=openedx
OIDC_SCOPES=email profile user_id
OIDC_REDIRECT_URI=https://lk.example.com/auth/oidc/callback
OIDC_LOGOUT_ENDPOINT=https://lms-staging.example.com/logout
OIDC_POST_LOGOUT_REDIRECT_URI=https://lk.example.com/
OIDC_FRONTEND_BASE_URL=https://lk.example.com
OIDC_RETURN_TO_ORIGINS=https://lms-staging.example.com,https://lk.example.com,https://scratch.example.com
LMS_URL=https://lms-staging.example.com

# Do NOT set OIDC_CLIENT_SECRET or OIDC_JWKS_FALLBACK_URI (public client + JWKS only).

AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=none
CORS_ALLOW_PRIVATE_NETWORK=false
CORS_ALLOWED_ORIGINS=https://lk.example.com,https://scratch.example.com
ELASTICSEARCH_ENABLED=false
