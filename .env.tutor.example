# Local Tutor (Open edX) as the only IdP + same MySQL as LMS.
# Copy selected lines into backend/.env after registering OAuth client lk-web.
# Do not use with ./setup.sh --oidc-mock.
#
# If VPN/FakeIP breaks *.local.overhang.io, run scripts/local_lms_loopback_proxy.py
# and use 127.0.0.1:18080 for browser-facing authorize/logout/LMS_URL; keep
# OIDC_ISSUER=http://local.overhang.io/oauth2 (token iss) and OIDC_AUDIENCE=openedx.

AUTH_MODE=oidc_bff
AUTH_LMS_PASSWORD_FALLBACK=false
LK_SSO_WITH_LMS_ENABLED=true

OIDC_ISSUER=http://local.overhang.io/oauth2
OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:18080/oauth2/authorize
OIDC_TOKEN_ENDPOINT=http://127.0.0.1:18080/oauth2/access_token
OIDC_JWKS_URI=http://127.0.0.1:18080/auth/jwks.json
OIDC_CLIENT_ID=lk-web
OIDC_AUDIENCE=openedx
OIDC_SCOPES=email profile user_id
OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
OIDC_LOGOUT_ENDPOINT=http://127.0.0.1:18080/logout
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3030/
OIDC_FRONTEND_BASE_URL=http://localhost:3030
OIDC_RETURN_TO_ORIGINS=http://127.0.0.1:18080,http://127.0.0.1:18081
LMS_URL=http://127.0.0.1:18080

# Tutor MySQL — adjust user/password from `tutor config printvalue MYSQL_ROOT_PASSWORD`
# and a least-privilege lk_readonly / lk_write account (not root).
# For dump-backed LK identity keep :3307; seamless LMS cookies still come from Tutor IdP login.
LMS_MYSQL_DSN=lk_readonly:change-me@tcp(host.docker.internal:3306)/openedx
LMS_MYSQL_WRITE_DSN=lk_write:change-me@tcp(host.docker.internal:3306)/openedx

# Reverse proxies (nginx) whose X-Forwarded-For is trusted for client IP: rate limits,
# session audit, YooKassa webhook IP check. Empty = TCP peer only. Prod behind nginx: set it,
# e.g. TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=
