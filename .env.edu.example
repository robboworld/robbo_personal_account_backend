# Prod deployment — copy secrets into backend/.env on the LK host (do not commit .env).
# Staging IdP switch: see backend/.env.edu.test-lms.example
# OAuth client lk-web on LMS must match redirect + scopes below.
# Runbook: architecture/runbooks/prod-edu-robbo-lk-rs.md

AUTH_MODE=oidc_bff
AUTH_LMS_PASSWORD_FALLBACK=false
LK_SSO_WITH_LMS_ENABLED=true
LEGACY_POSTGRES_ENABLED=false
PORTAL_OUTBOX_ENABLED=false

PROJECTS_POSTGRES_DSN=host=host.docker.internal port=5433 user=robbo_projects password=CHANGE_ME dbname=robbo_projects sslmode=disable
LICENSING_POSTGRES_DSN=host=host.docker.internal port=5434 user=robbo_licensing password=CHANGE_ME dbname=robbo_licensing sslmode=disable

# LMS MySQL — host = LMS server; allowlist LK egress IP on :3306 (see runbook)
LMS_MYSQL_DSN=lk_readonly:CHANGE_ME@tcp(203.0.113.10:3306)/openedx
LMS_MYSQL_WRITE_DSN=lk_write:CHANGE_ME@tcp(203.0.113.10:3306)/openedx

OIDC_ISSUER=https://lms.example.com/oauth2
OIDC_AUTHORIZATION_ENDPOINT=https://lms.example.com/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://lms.example.com/oauth2/access_token
OIDC_JWKS_URI=https://lms.example.com/auth/jwks.json
OIDC_CLIENT_ID=lk-web
OIDC_AUDIENCE=openedx
OIDC_SCOPES=email profile user_id
OIDC_REDIRECT_URI=https://lk.example.com/auth/oidc/callback
OIDC_LOGOUT_ENDPOINT=https://lms.example.com/logout
OIDC_POST_LOGOUT_REDIRECT_URI=https://lk.example.com/
OIDC_FRONTEND_BASE_URL=https://lk.example.com
OIDC_RETURN_TO_ORIGINS=https://lms.example.com,https://scratch.example.com
LMS_URL=https://lms.example.com

AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=none
CORS_ALLOW_PRIVATE_NETWORK=false
CORS_ALLOWED_ORIGINS=https://lk.example.com,https://scratch.example.com
ELASTICSEARCH_ENABLED=false

# Reverse proxies (nginx) whose X-Forwarded-For is trusted for client IP: rate limits,
# session audit, YooKassa webhook IP check. Empty = TCP peer only. Prod behind nginx: set it,
# e.g. TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=
